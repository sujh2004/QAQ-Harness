# Backend
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3307/devpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=devpilot
DB_PASSWORD=devpilot
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Agent runtime. Without DASHSCOPE_API_KEY the runtime still starts and every read API works;
# only agent runs fail, with an explicit "no model provider configured" error rather than a
# fabricated answer. The contract tests never need a key.
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
AGENT_PROFILE_VERSION=standard@1

# Frontend
VITE_API_BASE_URL=http://localhost:8080
